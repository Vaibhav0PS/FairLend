# Training image for SageMaker Processing or Training jobs.
# Uses the same pinned requirements.txt as the serving image, so the model is
# trained and served with identical library versions.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    GIT_PYTHON_REFRESH=quiet \
    MLFLOW_DISABLE_AGENT_HINT=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-train.txt ./
RUN pip install -r requirements-train.txt

COPY credit_risk/ credit_risk/

ENTRYPOINT ["python", "-m", "credit_risk.train"]
